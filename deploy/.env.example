# Example environment variables for local development and deployments.

# X (formerly Twitter) OAuth2 - fill in from your registered developer application
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/oauth/callback

# App config
NODE_ENV=production
DATABASE_URL=sqlite:./data/app.db

# Optional bearer token for API-only usage (store real value in secrets)
X_BEARER_TOKEN=
